# Получите бесплатный ключ на https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Не задано — локальная база lexi.db. Для Neon: postgresql://user:pass@host/db?sslmode=require
# DATABASE_URL=

# Подпись сессий входа. Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Сколько новых слов в сутки может создать обычный пользователь (у администратора лимита нет)
# DAILY_WORD_LIMIT=30

# 0 — закрыть регистрацию новых пользователей
# ALLOW_SIGNUP=1
